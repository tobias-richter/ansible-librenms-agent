[Unit]
Description=Check_MK LibreNMS Agent Socket

[Socket]
ListenStream={{ librenms_agent_check_mk_listenstream }}
{% if librenms_agent_check_mk_freebind | bool %}
FreeBind=yes
{% endif %}
Accept=yes
{% if librenms_agent_check_mk_max_connections | string | length %}
MaxConnections={{ librenms_agent_check_mk_max_connections }}
{% endif %}
{% if librenms_agent_check_mk_max_connections_per_source | string | length %}
MaxConnectionsPerSource={{ librenms_agent_check_mk_max_connections_per_source }}
{% endif %}

[Install]
WantedBy=sockets.target